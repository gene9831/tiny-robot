{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "customConditions": ["development"],
    "skipLibCheck": true
  },
  "include": [".vitepress/**/*.mts", "src/**/*.ts", "src/**/*.vue", "test/**/*.ts"]
}
